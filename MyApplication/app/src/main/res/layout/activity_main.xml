<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/res-auto"
    xmlns:app1="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:layout_editor_absoluteX="0dp"
    tools:layout_editor_absoluteY="81dp">

    <com.gaofei.app.act.view.swipetoloadlayout.SwipeToLoadLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app1:layout_constraintTop_toTopOf="parent"
        app1:layout_constraintBottom_toBottomOf="parent"
        android:layout_weight="1"
        android:background="#e8e8e8">

        <com.gaofei.app.act.view.swipetoloadlayout.SwipeRefreshHeaderLayout
            android:id="@+id/swipe_refresh_header"
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/swipe_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.gaofei.app.act.view.swipetoloadlayout.SwipeLoadMoreFooterLayout
            android:id="@+id/swipe_load_more_footer"
            android:layout_width="match_parent"
            android:layout_height="40dp" />
    </com.gaofei.app.act.view.swipetoloadlayout.SwipeToLoadLayout>

    <View
        android:id="@+id/anchor"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="200dp"
        android:layout_marginEnd="200dp"
        app1:layout_constraintBottom_toBottomOf="parent"
        app1:layout_constraintEnd_toEndOf="parent"
        android:background="@color/yc_red2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
